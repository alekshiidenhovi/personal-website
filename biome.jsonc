{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": ["**", "!node_modules/**/*", "!.pnpm-store/**/*"]
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "indentScriptAndStyle": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  // Google TypeScript Style Guide: single quotes unless the string contains one
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      // The breakpoints are custom media (see src/styles/media.css), which Lightning CSS compiles
      "suspicious": {
        "noUnknownAtRules": { "level": "error", "options": { "ignore": ["custom-media"] } }
      },
      "correctness": {
        "noUnknownMediaFeatureName": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      // Real media features are only written here, so check their names here
      "includes": ["src/styles/media.css"],
      "linter": { "rules": { "correctness": { "noUnknownMediaFeatureName": "error" } } }
    },
    {
      "includes": ["**/*.astro", "**/*.vue"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
