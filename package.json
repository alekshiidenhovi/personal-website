{
  "name": "personal-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "pnpm build && vite preview",
    "check": "vue-tsc -b && biome check .",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler versions upload --preview-alias preview",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:force": "biome lint --write --unsafe .",
    "lint:changed": "biome lint --changed"
  },
  "dependencies": {
    "vue": "3.5.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@cloudflare/vite-plugin": "^1.20.1",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/tsconfig": "0.7.0",
    "lightningcss": "1.30.1",
    "typescript": "~5.8.3",
    "vite": "7.1.2",
    "vue-tsc": "3.0.5",
    "wrangler": "^4.58.0"
  }
}
